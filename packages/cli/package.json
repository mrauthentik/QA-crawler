{
    "name": "qa-detective-cli",
    "version": "1.3.1",
    "description": "QA Detective CLI for scanning web apps (security, performance, accessibility, etc) ",
    "bin": {
        "qa-detective": "dist/index.js"
    },
    "keywords": [
        "qa",
        "security",
        "performance",
        "accessibility",
        "lighthouse",
        "artillery",
        "testing",
        "cli"
    ],
    "author": "https://github.com/mrauthentik/QA-crawler",
    "license": "MIT",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "build": "tsc",
        "start": "node dist/index.js",
        "dev": "ts-node src/index.ts",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:snapshot": "jest --updateSnapshot",
        "test:smoke": "npm run build && node test/cli-smoke.test.js",
        "test:all": "npm run test && npm run test:smoke",
        "postinstall": "puppeteer browsers install chrome"
    },
    "dependencies": {
        "chalk": "^5.3.0",
        "commander": "^11.0.0",
        "ora": "^7.0.1",
        "puppeteer": "^24.40.0",
        "ngrok": "^4.3.0",
        "localtunnel": "^2.0.2"
    },
    "devDependencies": {
        "ts-node": "^10.9.2",
        "typescript": "^5.3.3",
        "jest": "^29.7.0",
        "@types/jest": "^29.5.8",
        "ts-jest": "^29.1.1",
        "@types/localtunnel": "^2.0.4"
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=18.0.0"
    }
}
