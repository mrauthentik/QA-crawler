    "@qa-detective/reporter": "workspace:*",
    "bullmq": "^5.0.0",
    "dotenv": "^16.4.0",
    "express": "^4.18.0",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.11.0",
    "playwright": "^1.58.2",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/helmet": "^4.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.0",
    "@types/uuid": "^11.0.0",
    "tsx": "^4.7.0",
